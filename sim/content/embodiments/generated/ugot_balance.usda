#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    customData = {
        string aarnnIODigest = "1ff69274587c023d26c45273f0360c1f0c51db30d2a9030474160e5c242288d5"
        string aarnnModelDigest = "62922d2fa46382d4a16e936548b71c14d5aed46194b2a1f2e641b7322785dc0e"
    }
)
{
    def Xform "controller_module" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0023616666, 0.0048641665, 0.0061641666)
        float physics:mass = 1.3
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "controller_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.15, 0.35, 0.5)]
            float[] primvars:displayOpacity = [1]
            double size = 2
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.1, 0.065, 0.035)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Xform "wheel__1_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.00014, 0.00014, 0.00025)
        float physics:mass = 0.2
        quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, -0.09, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "wheel__1_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.03
            color3f[] primvars:displayColor = [(0.15, 0.35, 0.5)]
            float[] primvars:displayOpacity = [1]
            double radius = 0.05
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Xform "wheel_1_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.00014, 0.00014, 0.00025)
        float physics:mass = 0.2
        quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0.09, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cylinder "wheel_1_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.03
