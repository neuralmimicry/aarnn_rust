ARG TARGET_PAGE_SIZE=4k
FROM python:3.12-slim AS builder

ARG BUILD_NUMBER=0
ARG GIT_COMMIT=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY webots_service/requirements.txt /tmp/webots-service-requirements.txt
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /tmp/webots-service-requirements.txt

COPY webots_service /build/webots_service
COPY webots_world /build/webots_world

RUN /opt/venv/bin/python -c "import compileall, pathlib, shutil; package_dir = pathlib.Path('/build/webots_service'); compileall.compile_dir(str(package_dir), force=True, quiet=1, legacy=True); [path.unlink() for path in package_dir.rglob('*.py')]; [shutil.rmtree(path) for path in sorted(package_dir.rglob('__pycache__'), reverse=True)]"

FROM python:3.12-slim
ARG TARGET_PAGE_SIZE
ARG BUILD_NUMBER=0
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.title="NeuralMimicry Webots Broker" \
      org.opencontainers.image.source="https://github.com/neuralmimicry/aarnn_rust" \
      org.opencontainers.image.url="https://github.com/neuralmimicry/aarnn_rust" \
      org.opencontainers.image.description="NeuralMimicry Webots broker service for AARNN embodied simulation" \
      org.opencontainers.image.vendor="NeuralMimicry" \
      org.opencontainers.image.version="${BUILD_NUMBER}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.page-size="${TARGET_PAGE_SIZE}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/webots_service /app/webots_service
COPY --from=builder /build/webots_world /app/webots_world

EXPOSE 8080

ENTRYPOINT ["python", "-m", "webots_service"]
