        )
        {
            token axis = "Y"
            double radius = 0.05
            double height = 0.036
            color3f[] primvars:displayColor = [(0.04, 0.05, 0.06)]
        }
    }
    def PhysicsRevoluteJoint "rear_left_joint"
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </UGOTMecanum/base_link>
        rel physics:body1 = </UGOTMecanum/rear_left_wheel>
        float drive:angular:physics:maxForce = 0.196133
        float drive:angular:physics:maxVelocity = 2160.0
    }
    def Xform "rear_right_wheel" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
