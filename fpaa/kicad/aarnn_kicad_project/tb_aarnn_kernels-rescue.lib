#encoding utf-8
#
# AARNN_ACTIVE_DENDRITE
#
DEF AARNN_ACTIVE_DENDRITE X 0 40 Y Y 1 F N
F0 "X" 0 100 50 H V C CNN
F1 "AARNN_ACTIVE_DENDRITE" 0 0 45 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
F4 "" 0 0 50 H I C CNN
DRAW
S -400 350 400 -350 0 1 12 f
X synout 1 -600 200 200 R 40 40 1 1 I
X local 2 -600 0 200 R 40 40 1 1 I
X branch 3 -600 -200 200 R 40 40 1 1 I
X ca 4 600 200 200 L 40 40 1 1 O
X plateau 5 600 0 200 L 40 40 1 1 O
X dendout 6 600 -200 200 L 40 40 1 1 O
X 0 7 0 -550 200 U 40 40 1 1 W
ENDDRAW
ENDDEF
